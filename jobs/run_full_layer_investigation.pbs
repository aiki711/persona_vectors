#!/bin/bash
#PBS -N full_layer_inv
#PBS -q GPU-1
#PBS -o log/full_layer_inv.o%j
#PBS -e log/full_layer_inv.e%j
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

WORKDIR="${PBS_O_WORKDIR:-$PWD}"
RUN_ID="${PBS_JOBID:-bash_$(date +%Y%m%d_%H%M%S)}"

cd "$WORKDIR"
mkdir -p log exp_adaptive_steering/results

LOG_FILE="log/full_layer_inv.${RUN_ID}.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=== STARTING FULL-LAYER TAU INVESTIGATION ==="
echo "START TIME: $(date)"

# ==================== Project Setup ====================
export PROJECT_DIR="$WORKDIR"
export PYTHONPATH="$PROJECT_DIR/src:$PROJECT_DIR:$PROJECT_DIR/scripts:${PYTHONPATH:-}"
export HF_HOME="$PROJECT_DIR/.hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"
export OMP_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false

# ==================== Tokens ====================
if [ -f "$PROJECT_DIR/.hf_token" ]; then
  export HUGGINGFACE_HUB_TOKEN="$(head -n1 "$PROJECT_DIR/.hf_token" | tr -d '\r\n' | sed 's/^Bearer[[:space:]]\+//')"
fi

# ==================== venv ====================
VENV="$PROJECT_DIR/persona_steering"
if [ -x "$VENV/bin/python" ]; then
  export PYTHON_BIN="$VENV/bin/python"
else
  CONDA_PYTHON="/home/s2550009/anaconda3/envs/persona_vectors/bin/python"
  if [ -x "$CONDA_PYTHON" ]; then
    export PYTHON_BIN="$CONDA_PYTHON"
  else
    echo "[ERROR] Python bin not found."
    exit 1
  fi
fi

# ==================== Params ====================
TRAIT="extraversion"
CONFIG="config/mistral_7b.yaml"
PROMPT_IN="exp_adaptive_steering/results/test_prompts_10.jsonl"
JUDGE_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"

# Sweep Matrix (Tau and Alpha are the same)
PARAMS=(4 5 6)

# ==================== Loop ====================
for VAL in "${PARAMS[@]}"; do
    echo "##################################################"
    echo "  SWEEP POINT: Tau=Alpha=$VAL"
    echo "##################################################"

    TAG="FullLayer_Val${VAL}"
    OUT_JSONL="exp_adaptive_steering/results/investigation_${TRAIT}_${TAG}.jsonl"
    OUT_CSV="exp_adaptive_steering/results/scores_investigation_${TRAIT}_${TAG}.csv"

    # 1. Run Generation (Base, Constant, Adaptive)
    "$PYTHON_BIN" scripts/32b_run_full_layer_steering.py \
        --config "$CONFIG" \
        --vector_bank exp_adaptive_steering/vectors/mean_diff_vectors.npz \
        --prompts "$PROMPT_IN" \
        --out_dir exp_adaptive_steering/results \
        --axis "$TRAIT" \
        --tau "$VAL" \
        --alpha "$VAL" \
        --mode both \
        --tag "$TAG"
        
    # The script saves to investigation_{axis}_{direction}_T{tau}_A{alpha}{tag}.jsonl
    # Note: direction defaults to "high"
    # Actual filename: investigation_extraversion_high_T4.0_A4.0_FullLayer_Val4.jsonl
    
    EXPECTED_JSONL="exp_adaptive_steering/results/investigation_${TRAIT}_high_T${VAL}.0_A${VAL}.0_${TAG}.jsonl"
    if [ -f "$EXPECTED_JSONL" ]; then
        mv "$EXPECTED_JSONL" "$OUT_JSONL"
    fi

    # 2. Evaluate with Llama-3 Judge
    "$PYTHON_BIN" scripts/33_eval_adaptive_steering.py \
        --input "$OUT_JSONL" \
        --output "$OUT_CSV" \
        --axis "$TRAIT" \
        --model "$JUDGE_MODEL"

    echo "Finished Val=$VAL"
done

echo "=== INVESTIGATION COMPLETED ==="
echo "END TIME: $(date)"
