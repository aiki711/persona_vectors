#!/bin/bash
#PBS -N dls_calibrate
#PBS -q GPU-1
#PBS -l nodes=1:ppn=1:gpus=1
#PBS -l walltime=04:00:00
#PBS -o /home/s2550009/persona_vectors/log/dls_calibrate.out
#PBS -e /home/s2550009/persona_vectors/log/dls_calibrate.err

WORKDIR="/home/s2550009/persona_vectors"
cd "$WORKDIR"

export PYTHONPATH="$WORKDIR/src:$WORKDIR:$WORKDIR/scripts:${PYTHONPATH:-}"
PYTHON_BIN="$WORKDIR/persona_steering/bin/python3"

echo "Running DLS Calibration..."
"$PYTHON_BIN" scripts/04_dyn_layer/64_calibrate_dls_stats.py \
    --config config/mistral_7b.yaml \
    --vector_bank exp_steering_layer_analysis/vectors/mean_diff_vectors.npz \
    --prompts exp_steering_layer_analysis/test_prompts_10.jsonl \
    --out_file exp_steering_dyn_layer_zscore/dls_calibration_stats.json \
    --num_prompts 50

echo "Calibration done."
