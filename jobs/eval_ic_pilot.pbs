#!/bin/bash
#SBATCH --job-name=eval_ic_pilot
#SBATCH --partition=GPU-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --time=00:30:00
#SBATCH --output=log/eval_ic_pilot.out
#SBATCH --error=log/eval_ic_pilot.err

WORKDIR="/home/s2550009/persona_vectors"
cd "$WORKDIR"

export PYTHONPATH="$WORKDIR/src:$WORKDIR:$WORKDIR/scripts:${PYTHONPATH:-}"
PYTHON_BIN="$WORKDIR/persona_steering/bin/python3"

"$PYTHON_BIN" scripts/03_ic_adaptive/51_eval_ic_adaptive_pilot.py
