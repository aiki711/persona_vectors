#!/bin/bash
#SBATCH --job-name=re_eval_conscientiousness
#SBATCH --partition=GPU-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --time=12:00:00
#SBATCH --output=log/re_eval_conscientiousness.%j.out
#SBATCH --error=log/re_eval_conscientiousness.%j.err

set -euo pipefail

WORKDIR="/home/s2550009/persona_vectors"
cd "$WORKDIR"

export PYTHONPATH="$WORKDIR/src:$WORKDIR:$WORKDIR/scripts:${PYTHONPATH:-}"
export HF_HOME="$WORKDIR/.hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"

if [ -f "$WORKDIR/.hf_token" ]; then
  export HUGGINGFACE_HUB_TOKEN="$(head -n1 "$WORKDIR/.hf_token" | tr -d '\r\n')"
fi

echo "=== STARTING RE-EVALUATION [conscientiousness] ==="
echo "START TIME: $(date)"

/home/s2550009/persona_vectors/persona_steering/bin/python scripts/re_evaluate_sweep.py --trait conscientiousness

echo "=== RE-EVALUATION [conscientiousness] COMPLETED ==="
echo "END TIME: $(date)"
