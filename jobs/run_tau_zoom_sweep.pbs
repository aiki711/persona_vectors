#!/bin/bash
#PBS -N tau_zoom_sweep
#PBS -q GPU-1
#PBS -o log/tau_zoom_sweep.o%j
#PBS -e log/tau_zoom_sweep.e%j
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

WORKDIR="${PBS_O_WORKDIR:-$PWD}"
cd "$WORKDIR"
mkdir -p log

echo "=== STARTING TAU ZOOM SWEEP ==="
echo "START TIME: $(date)"

# ==================== Project Setup ====================
export PROJECT_DIR="$WORKDIR"
export PYTHONPATH="$PROJECT_DIR/src:$PROJECT_DIR:$PROJECT_DIR/scripts:${PYTHONPATH:-}"
export HF_HOME="$PROJECT_DIR/.hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

# Tokens
if [ -f "$PROJECT_DIR/.hf_token" ]; then
  export HUGGINGFACE_HUB_TOKEN="$(head -n1 "$PROJECT_DIR/.hf_token" | tr -d '\r\n' | sed 's/^Bearer[[:space:]]\+//')"
fi

CONDA_PYTHON="/home/s2550009/anaconda3/envs/persona_vectors/bin/python"
export PYTHON_BIN="$CONDA_PYTHON"

# ==================== Sweep Params ====================
TRAITS=("extraversion" "openness")
LAYER=15
CONFIG="config/mistral_7b.yaml"
PROMPT_IN="exp_adaptive_steering/results/test_prompts_10.jsonl"
JUDGE_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"

TAUS=("4.0" "5.0" "6.0" "7.0" "8.0")
ALPHAS=("15.0" "30.0" "50.0" "70.0" "100.0")
METHODS=("svm" "mean_diff")

MD_BANK="exp_adaptive_steering/vectors/mean_diff_vectors.npz"
SVM_BANK="exp_adaptive_steering/vectors/boundary_vectors.npz"

for TRAIT in "${TRAITS[@]}"; do
    for METHOD in "${METHODS[@]}"; do
        if [ "$METHOD" == "svm" ]; then
            BANK="$SVM_BANK"
        else
            BANK="$MD_BANK"
        fi

        for TAU in "${TAUS[@]}"; do
            for ALPHA in "${ALPHAS[@]}"; do
                TAG="stress_${METHOD}_T${TAU}_A${ALPHA}"
                
                OUT_JSONL="exp_adaptive_steering/results/adaptive_${TRAIT}_high_L${LAYER}_${TAG}.jsonl"
                OUT_CSV="exp_adaptive_steering/results/scores_adaptive_${TRAIT}_high_L${LAYER}_${TAG}.csv"

                if [ -f "$OUT_CSV" ]; then
                    echo "Skipping ${TRAIT} ${TAG} (already exists)"
                    continue
                fi

                echo "--- TRAIT: $TRAIT | METHOD: $METHOD | TAU: $TAU | ALPHA: $ALPHA ---"
                "$PYTHON_BIN" scripts/02_base_steering/32_run_adaptive_steering.py \
                    --config "$CONFIG" \
                    --boundary_bank "$BANK" \
                    --prompts "$PROMPT_IN" \
                    --out_dir exp_adaptive_steering/results \
                    --axis "$TRAIT" \
                    --layer "$LAYER" \
                    --tau "$TAU" \
                    --max_alpha "$ALPHA" \
                    --tag "$TAG"
                    
                "$PYTHON_BIN" scripts/02_base_steering/33_eval_adaptive_steering.py \
                    --input "$OUT_JSONL" \
                    --output "$OUT_CSV" \
                    --axis "$TRAIT" \
                    --model "$JUDGE_MODEL"
            done
        done
    done
done

echo "=== TAU ZOOM SWEEP COMPLETED ==="
echo "END TIME: $(date)"
