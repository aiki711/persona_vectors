#!/bin/bash
#SBATCH --job-name=dls_openness
#SBATCH --partition=GPU-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --output=log/dls_openness.out
#SBATCH --error=log/dls_openness.err

WORKDIR="/home/s2550009/persona_vectors"
cd "$WORKDIR"

export PYTHONPATH="$WORKDIR/src:$WORKDIR:$WORKDIR/scripts:${PYTHONPATH:-}"
PYTHON_BIN="$WORKDIR/persona_steering/bin/python3"

OUT_DIR="exp_steering_dyn_layer/results/openness"
mkdir -p "$OUT_DIR"

CONFIG="config/mistral_7b.yaml"
VECTOR_BANK="exp_steering_layer_analysis/vectors/mean_diff_vectors.npz"
PROMPT_IN="exp_steering_layer_analysis/test_prompts_10.jsonl"
JUDGE_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"

VALS=(0.5 1.0 2.0 4.0 5.0 6.0 8.0 10.0 15.0 20.0 25.0 30.0 35.0 40.0)

for V in "${VALS[@]}"; do
    echo "=== DLS: Trait=openness, Alpha=$V ==="
    JSONL_OUT="${OUT_DIR}/dyn_Val${V}.jsonl"
    CSV_OUT="${OUT_DIR}/scores_dyn_Val${V}.csv"

    if [ ! -f "$JSONL_OUT" ]; then
        "$PYTHON_BIN" scripts/59_run_dynamic_layer_steering.py \
            --config "$CONFIG" \
            --vector_bank "$VECTOR_BANK" \
            --prompts "$PROMPT_IN" \
            --out_dir "$OUT_DIR" \
            --axis "openness" \
            --alpha "$V"
    else
        echo "  [SKIP] Generation done: $JSONL_OUT"
    fi

    if [ ! -f "$CSV_OUT" ]; then
        "$PYTHON_BIN" scripts/59_eval_dynamic_layer.py \
            --input "$JSONL_OUT" \
            --output "$CSV_OUT" \
            --axis "openness" \
            --model "$JUDGE_MODEL"
    else
        echo "  [SKIP] Evaluation done: $CSV_OUT"
    fi
done
