#!/bin/bash
#SBATCH --job-name=pairwise_eval
#SBATCH --partition=GPU-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --time=48:00:00
#SBATCH --output=log/pairwise_eval.%j.out
#SBATCH --error=log/pairwise_eval.%j.err

set -euo pipefail

WORKDIR="/home/s2550009/persona_vectors"
cd "$WORKDIR"

export PYTHONPATH="$WORKDIR/src:$WORKDIR:$WORKDIR/scripts:${PYTHONPATH:-}"
export HF_HOME="$WORKDIR/.hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"

if [ -f "$WORKDIR/.hf_token" ]; then
  export HUGGINGFACE_HUB_TOKEN="$(head -n1 "$WORKDIR/.hf_token" | tr -d '\r\n')"
fi

PYTHON_BIN="/home/s2550009/persona_vectors/persona_steering/bin/python"

echo "=== STARTING COMPREHENSIVE PAIRWISE EVALUATION ==="
echo "START TIME: $(date)"

TRAITS=("extraversion" "neuroticism" "openness" "conscientiousness" "agreeableness")

for TRAIT in "${TRAITS[@]}"; do
    echo "Processing Pairwise for TRAIT: $TRAIT ..."
    "$PYTHON_BIN" scripts/re_evaluate_pairwise_sweep.py --trait "$TRAIT"
done

echo "=== PLOTTING RESULTS ==="
"$PYTHON_BIN" scripts/45_plot_pairwise_analysis.py

echo "=== ALL PAIRWISE TASKS COMPLETED ==="
echo "END TIME: $(date)"
