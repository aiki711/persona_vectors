#!/bin/bash
#PBS -N adaptive_sweep
#PBS -q GPU-1
#PBS -o log/adaptive_sweep.o%j
#PBS -e log/adaptive_sweep.e%j
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

WORKDIR="${PBS_O_WORKDIR:-$PWD}"
RUN_ID="${PBS_JOBID:-bash_$(date +%Y%m%d_%H%M%S)}"

cd "$WORKDIR"
mkdir -p log
LOG_FILE="log/adaptive_sweep.${RUN_ID}.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=== STARTING ADAPTIVE STEERING PARAMETER SWEEP ==="
echo "START TIME: $(date)"

# ==================== Project Setup ====================
export PROJECT_DIR="$WORKDIR"
export PYTHONPATH="$PROJECT_DIR/src:$PROJECT_DIR:$PROJECT_DIR/scripts:${PYTHONPATH:-}"
export HF_HOME="$PROJECT_DIR/.hf_cache"
export TRANSFORMERS_CACHE="$HF_HOME"
export OMP_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false

# ==================== Tokens ====================
if [ -f "$PROJECT_DIR/.hf_token" ]; then
  export HUGGINGFACE_HUB_TOKEN="$(head -n1 "$PROJECT_DIR/.hf_token" | tr -d '\r\n' | sed 's/^Bearer[[:space:]]\+//')"
fi

# ==================== venv ====================
VENV="$PROJECT_DIR/persona_steering"
if [ -x "$VENV/bin/python" ]; then
  export PYTHON_BIN="$VENV/bin/python"
else
  CONDA_PYTHON="/home/s2550009/anaconda3/envs/persona_vectors/bin/python"
  if [ -x "$CONDA_PYTHON" ]; then
    export PYTHON_BIN="$CONDA_PYTHON"
  else
    echo "[ERROR] Python bin not found."
    exit 1
  fi
fi

# ==================== Experiment Params ====================
LAYER=15
TRAITS=("extraversion" "neuroticism" "agreeableness" "conscientiousness" "openness")
CONFIG="config/mistral_7b.yaml"
PROMPT_IN="exp_adaptive_steering/results/test_prompts_10.jsonl"
JUDGE_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"

# Sweep Matrix (Tau, Max_Alpha)
PARAMS=(
    "3.0|10.0"
    "4.0|15.0"
)

# ==================== Loop ====================
for P in "${PARAMS[@]}"; do
    IFS='|' read -r TAU MAX_ALPHA <<< "$P"
    echo "##################################################"
    echo "  SWEEP POINT: TAU=$TAU, MAX_ALPHA=$MAX_ALPHA"
    echo "##################################################"

    for TRAIT in "${TRAITS[@]}"; do
        echo "Processing Trait: $TRAIT"
        
        TAG="T${TAU}_A${MAX_ALPHA}"
        OUT_JSONL="exp_adaptive_steering/results/adaptive_${TRAIT}_${TAG}_L${LAYER}.jsonl"
        OUT_CSV="exp_adaptive_steering/results/scores_adaptive_${TRAIT}_${TAG}_L${LAYER}.csv"
        OUT_PLOT="exp_adaptive_steering/figures/tradeoff_${TRAIT}_${TAG}_L${LAYER}.png"

        # 1. Run Adaptive Steering
        # We skip constant/base if they were already run? 
        # Actually 32_run_adaptive_steering.py always runs base/const. 
        # To save time, we could have a version that only runs adaptive.
        # But for now, we'll run it as is.
        "$PYTHON_BIN" scripts/32_run_adaptive_steering.py \
            --config "$CONFIG" \
            --boundary_bank exp_adaptive_steering/vectors/boundary_vectors.npz \
            --prompts "$PROMPT_IN" \
            --out_dir exp_adaptive_steering/results \
            --axis "$TRAIT" \
            --layer "$LAYER" \
            --tau "$TAU" \
            --max_alpha "$MAX_ALPHA"
            
        # The script 32 saves to: adaptive_{axis}_{direction}_L{layer}.jsonl
        # We need to rename it to avoid overwriting the standard one or each other.
        mv "exp_adaptive_steering/results/adaptive_${TRAIT}_high_L${LAYER}.jsonl" "$OUT_JSONL"

        # 2. Evaluate with LLM Judge
        "$PYTHON_BIN" scripts/33_eval_adaptive_steering.py \
            --input "$OUT_JSONL" \
            --output "$OUT_CSV" \
            --axis "$TRAIT" \
            --model "$JUDGE_MODEL"

        # 3. Plot Trade-off
        "$PYTHON_BIN" scripts/34_plot_adaptive_tradeoff.py \
            --input "$OUT_CSV" \
            --output "$OUT_PLOT" \
            --axis "$TRAIT"
            
        echo "Finished $TRAIT for $TAG"
    done
done

echo "=== SWEEP COMPLETED ==="
echo "END TIME: $(date)"
