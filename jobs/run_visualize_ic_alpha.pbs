#!/bin/bash
#SBATCH --job-name=vis_ic_alpha
#SBATCH --partition=GPU-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --time=00:20:00
#SBATCH --output=log/vis_ic_alpha.out
#SBATCH --error=log/vis_ic_alpha.err

WORKDIR="/home/s2550009/persona_vectors"
cd "$WORKDIR"

source persona_steering/bin/activate
export PYTHONPATH="${WORKDIR}/src:${WORKDIR}/scripts:$PYTHONPATH"

echo "Running 58_visualize_ic_token_alpha.py..."
python3 scripts/58_visualize_ic_token_alpha.py
